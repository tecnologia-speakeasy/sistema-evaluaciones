# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.

# Postgres (VPS). El schema va en ?schema= y la app lo aplica como search_path.
# Agrega &sslmode=require si el servidor exige SSL.
DATABASE_URL=postgresql://usuario:contraseña@host:5432/basedatos?schema=evaluacion

# Firma HMAC de la cookie de sesión (mínimo 32 caracteres). Para generarla:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Cambiarla cierra todas las sesiones abiertas.
SESSION_SECRET=

# OpenAI: escribe el feedback general de cada intento (una llamada, como a2) y,
# solo con PREGUNTAS_ABIERTAS_ACTIVAS=true, califica las abiertas con su rúbrica.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Opcional, solo para pruebas: otra URL compatible (un servidor simulado).
# OPENAI_BASE_URL=http://127.0.0.1:2626/v1

# Correo (SMTP de Google Workspace): el resultado de cada intento y el código de
# acceso de los estudiantes (este, solo con OTP_ACTIVO=true).
# Puerto 465 = SSL, 587 = STARTTLS. SMTP_PASS es una contraseña de aplicación.
# En desarrollo, sin SMTP_HOST/SMTP_USER/SMTP_PASS el código de acceso se
# muestra en la consola del servidor en vez de enviarse. En producción es obligatorio.
# En pruebas no uses el SMTP real: déjalo vacío o apunta a un SMTP local.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Speak Easy <correo@tu-dominio.com>"

# Preguntas abiertas (las califica la IA con su rúbrica). No existían en a2 y por
# ahora no se usan.
#   false (por defecto) = no se pueden crear; las que ya existan no las ve el
#                         estudiante ni cuentan; la IA solo escribe el feedback.
#   true                = se crean y la IA las califica (una llamada más por intento).
PREGUNTAS_ABIERTAS_ACTIVAS=false

# Peso de cada pregunta (su puntaje). Ponerla igual en el portal.
#   false (por defecto) = todas valen lo mismo (100 ÷ número de preguntas) y el
#                         editor no pide el puntaje.
#   true                = cada pregunta pesa su puntaje (se pide en el editor).
PESOS_POR_PREGUNTA=false

# Opcional. Reproceso de intentos sin terminar y envíos pendientes
# (/api/cron/procesar), hoy SIN PROGRAMAR: como a2, la pantalla de calificando
# reintenta hasta tener el feedback y el staff usa "Reintentar IA". Si algún día
# se programa, se llama con Authorization: Bearer <CRON_SECRET> (mínimo 16
# caracteres). Vacía, la app funciona igual y esa ruta responde 401.
CRON_SECRET=

# Login de estudiantes con código por correo (OTP).
#   false (por defecto) = como en a2: correo autorizado + nombre, sin código.
#   true                = además un código de 6 dígitos que llega por correo.
OTP_ACTIVO=false

# Límites de envío del código de acceso (solo con OTP_ACTIVO=true; protegen el
# cupo diario del SMTP). Opcionales: estos son los valores por defecto. El de IP
# es más alto porque un salón o el club comparten la misma red.
OTP_MAX_ENVIOS_POR_CORREO=3
OTP_MAX_ENVIOS_POR_IP=30
OTP_VENTANA_ENVIOS_MIN=15
